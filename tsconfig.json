{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "mocha"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "noEmit": true
  },
  "include": ["src/**/*", "test/**/*"],
  // cjsStyle's own router.ts/paths.ts deliberately use an extensionless
  // relative import (see test/typegenFixtures/cjsStyle/router.ts) --
  // NodeNext (this project's own module setting) forbids that outright,
  // so this pair type-checks against its own sibling tsconfig.json
  // (classic Node resolution) instead, passed explicitly wherever
  // applyGeneratedResponseSchemas is given this fixture in tests.
  "exclude": ["dist", "test/typegenFixtures/cjsStyle"]
}
