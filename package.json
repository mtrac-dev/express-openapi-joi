{
  "name": "@mtrac/express-openapi-joi",
  "version": "0.2.0",
  "description": "Generate OpenAPI documents from Express routes validated with Joi",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./typegen": {
      "types": "./dist/esm/typegen/index.d.ts",
      "import": "./dist/esm/typegen/index.js",
      "require": "./dist/cjs/typegen/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepare": "npm run build",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "build": "npm run build:esm && npm run build:cjs",
    "postbuild": "echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint --ext .ts .",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-coverage": "c8 check-coverage",
    "report": "c8 report",
    "pretest": "npm run typecheck",
    "test": "c8 mocha test",
    "test:unit": "mocha test",
    "test:watch": "mocha test --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtrac-dev/express-openapi-joi.git"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "keywords": [
    "express",
    "openapi",
    "joi",
    "swagger",
    "typescript"
  ],
  "author": "Michael Tracy <mike@mtrac.dev>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mtrac-dev/express-openapi-joi/issues"
  },
  "homepage": "https://github.com/mtrac-dev/express-openapi-joi#readme",
  "peerDependencies": {
    "express": "^4.19.0 || ^5.0.0",
    "joi": "^17.0.0 || ^18.0.0"
  },
  "dependencies": {
    "joi-to-json": "^5.0.5",
    "openapi3-ts": "^4.6.1",
    "ts-json-schema-generator": "^2.9.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.6",
    "@types/chai": "^5.2.3",
    "@types/express": "^5.0.5",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/qs": "^6.15.1",
    "@types/sinon": "^22.0.2",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-sonarjs": "^4.0.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "express": "^5.1.0",
    "joi": "^18.3.1",
    "mocha": "^12.0.3",
    "prettier": "^3.8.1",
    "sinon": "^22.1.0",
    "supertest": "^7.2.2",
    "typescript": "6.0.3"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "mocha": {
    "exit": true,
    "extension": [
      ".spec.ts"
    ],
    "recursive": true,
    "timeout": 20000
  },
  "c8": {
    "statements": 100,
    "branches": 90,
    "functions": 100,
    "lines": 100,
    "include": [
      "src/**/*.ts"
    ],
    "reporter": [
      "html",
      "lcov",
      "text",
      "text-summary"
    ],
    "report-dir": "./reports/coverage",
    "cache": true,
    "all": true
  }
}
